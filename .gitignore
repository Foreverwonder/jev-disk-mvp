# ---------------------------------------------------------------
# 会话与本机产物 —— 不进仓库
# ---------------------------------------------------------------
.workbuddy/
# 会话里临时生成的探针 / 校验 / 清理脚本，命名统一带下划线前缀
_probe*
_scan_*
_verify_*
_cleanup_*
*.tmp

# ---------------------------------------------------------------
# 项目内部工作产物
#   （jev-disk-mvp/.gitignore 已覆盖 key.txt / cache/ / __pycache__，
#     下面这几条是它管不到的）
# ---------------------------------------------------------------
# 修复过程中的本地回退点，不是项目内容
jev-disk-mvp/_backup/
# 服务运行日志
jev-disk-mvp/_server_out.txt
# 测试跑出来的临时输出与调试残留
jev-disk-mvp/tests/*_last.txt
jev-disk-mvp/tests/_dbg*
